# ==== tgweb: WEB-прокси для Telegram (обязательные) ====

# Ваш домен, A-запись которого смотрит на ПУБЛИЧНЫЙ IPv4 ЭТОГО сервера.
# Строчными буквами, без https://, без порта и путей.
WEB_HOSTNAME=tg1.example.com

# Клиентский MTProxy-секрет: 32 строчных hex-символа.
# Сгенерируйте: openssl rand -hex 16
WEB_SECRET=000102030405060708090a0b0c0d0e0f

# Почта для сертификатов Let's Encrypt (ACME)
ACME_EMAIL=you@example.com

# ==== необязательные ====

# Путь на том же домене (если домен один и путь занят основным сайтом),
# например base-path. Пусто = прокси на корне домена.
BASE_PATH=

# Транспорт: https (по умолчанию) или ws
CARRIER_MODE=https

# Сколько ядер — столько воркеров MTProxy (начните с 1)
MTPROXY_WORKERS=1
MTPROXY_MAX_CONNECTIONS=4096

# Только если сервер за NAT: "внутренний_ip:публичный_ip"
# (например 10.0.0.5:203.0.113.7). Без этого за NAT middle-end соединения
# молча обрываются и прокси "виснет".
MTPROXY_NAT_INFO=
