# ============================================================
# proxy_rail — переменные окружения
# ============================================================

# ---- Общие ------------------------------------------------
# core = админка + бот | node = прокси-сервер | all = всё вместе (локально)
ROLE=core
PORT=8000
DATA_DIR=/data

# ---- NODE (прокси-сервер) ---------------------------------
# Секретный токен управления нодой (заполняется и в админке core)
NODE_TOKEN=change-me-long-random-token
# Внутренние порты прокси
HTTP_PROXY_PORT=8888
SOCKS_PORT=1080
# Разрешить прокси без логина/пароля (НЕ рекомендуется)
ALLOW_ANONYMOUS=false
# Лимит тела запроса (МБ) и таймаут простоя туннеля (сек)
MAX_BODY_MB=50
IDLE_TIMEOUT=600

# Авто-регистрация ноды в core (необязательно):
# CORE_URL=https://core-production.up.railway.app
# REG_TOKEN=такой-же-как-на-core
# NODE_NAME=node1
# PUBLIC_CONTROL_URL=https://node1-production.up.railway.app
# PUBLIC_PROXY_HOST=xxx.up.rlwy.net
# PUBLIC_HTTP_PORT=31234
# PUBLIC_SOCKS_PORT=45678

# ---- CORE (админка + бот) ---------------------------------
# Пароль входа в веб-админку (ОБЯЗАТЕЛЬНО сменить)
ADMIN_PASSWORD=change-me-admin
# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (можно узнать у @userinfobot), можно несколько через запятую
ADMIN_TG_IDS=123456789
# Токен регистрации нод (нода при авто-регистрации шлёт его же)
REG_TOKEN=change-me-reg-token
